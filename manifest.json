{
  "schemaVersion": 1,
  "id": "com.opencode2pi",
  "name": "OpenCode免费模型",
  "version": "0.5.1",
  "description": "OpenCode Zen 匿名免费模型接入 PI-Desktop 模型选择器：manifest 声明 provider（provider.register），后台服务在 127.0.0.1 起回环端点（background.service），以 opencode2dsh 的伪装请求头与免费通道门禁转发到 https://opencode.ai/zen。会话 id 采用 OpenCode 官方时钟派生（v0.5 起修复 403 FreeTierError），思考档位仅在用户选择时写入。无需任何 API 密钥。",
  "main": "main.js",
  "permissions": [
    "provider.register",
    "background.service"
  ],
  "engines": {
    "piDesktop": ">=0.9.0"
  },
  "activationEvents": [
    "onStartup"
  ],
  "contributes": {
    "services": [
      {
        "id": "zen-proxy",
        "label": "OpenCode Zen provider endpoint"
      }
    ],
    "commands": [
      {
        "id": "opencode.refresh",
        "title": "OpenCode免费模型: 刷新模型目录",
        "category": "AI",
        "keywords": [
          "opencode",
          "zen",
          "刷新模型",
          "refresh"
        ]
      },
      {
        "id": "opencode.status",
        "title": "OpenCode免费模型: 显示状态",
        "category": "AI",
        "keywords": [
          "opencode",
          "zen",
          "状态",
          "诊断",
          "status"
        ]
      }
    ],
    "providers": [
      {
        "id": "opencode-free",
        "name": "OpenCode免费模型",
        "vendorKey": "opencode",
        "baseUrl": "http://127.0.0.1:41860/v1",
        "apiStyle": "chat_completions",
        "authKind": "none",
        "models": [
          {
            "id": "beam-free",
            "name": "beam-free",
            "contextWindow": 1048576,
            "maxTokens": 131072,
            "supportsImages": false,
            "thinkingLevels": [
              "low",
              "medium",
              "high",
              "xhigh",
              "max"
            ],
            "defaultThinkingLevel": "medium"
          },
